# PR-Hub Craft - Optional Environment Variables

# Backend server port (Default: 4321)
PORT=4321

# Additional directories to scan for local git worktrees (comma-separated)
# Example: /home/user/projects,/workspace
WORKTREE_SCAN_DIRS=

# Optional list of official maintainer logins (comma-separated)
# If empty, any non-bot human reviewer is treated as a valid reviewer.
# Example: octocat,maintainer1
MAINTAINER_LOGINS=
